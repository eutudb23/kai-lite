@@ -224,2 +224,28 @@ static id YTKACEFindExpandableText(id node, NSUInteger depth) {
 
+static BOOL YTKACEIsOriginalPost(id node) {
+    return [[node description] containsString:@"id.ui.backstage.original_post"];
+}
+
+static id YTKACEPostContainerForNode(id node, NSUInteger depth) {
+    if (node == nil || depth > 8) return nil;
+    if (YTKACEIsOriginalPost(node)) return node;
+    id parents = YTKACENodeValue(node, @"supernodes");
+    if ([parents respondsToSelector:@selector(allObjects)]) parents = [parents allObjects];
+    for (id parent in parents) {
+        id found = YTKACEPostContainerForNode(parent, depth + 1);
+        if (found != nil) return found;
+    }
+    return nil;
+}
+
+static id YTKACEPostContainerForView(UIView *view) {
+    for (UIView *candidate = view; candidate != nil; candidate = candidate.superview) {
+        for (NSString *getter in @[@"keepalive_node", @"node"]) {
+            id found = YTKACEPostContainerForNode(YTKACENodeValue(candidate, getter), 0);
+            if (found != nil) return found;
+        }
+    }
+    return nil;
+}
